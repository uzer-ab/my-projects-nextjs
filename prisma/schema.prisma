// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model test {
  id        Int      @id @default(autoincrement())
  name      String
}

model users {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  name        String
  title       String?
  intro       String?
  active      Boolean   @default(true)
  created_at  DateTime  @default(now())

  projects  projects[] // relation: one user → many projects
}

model projects {
  id          Int       @id @default(autoincrement())
  username    String
  name        String
  description String    @db.VarChar(1024) // or just String if you don't care about exact length
  show        Boolean   @default(true)
  created_at   DateTime  @default(now())

  user        users     @relation(fields: [username], references: [username])
  link        project_links[]
  tool        tools[]
}

model project_links {
  id          Int       @id @default(autoincrement())
  project_id   Int
  title       String
  url         String

  project     projects  @relation(fields: [project_id], references: [id])
}

model tools {
  id          Int       @id @default(autoincrement())
  project_id  Int
  name        String
  type        String
  description String

  projects    projects  @relation(fields: [project_id], references: [id])
}